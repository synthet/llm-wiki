# Secrets — never commit
secrets.json
secrets.*.json
credentials.json
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx

# Local machine-specific agent config
.claude/settings.local.json
.cursor/mcp.json

# Agent working dirs (gitignored; only curated memory.md is shared)
.agent/scratch/*
!.agent/scratch/.gitkeep
.agent-memory/raw-sessions/*
!.agent-memory/raw-sessions/.gitkeep
.agent-memory/dreams/*
!.agent-memory/dreams/.gitkeep

# External CLI review outputs
.agent-runs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.llmwiki/

# Node
node_modules/
dist/

# Opt-in Graphify local graph (operator-built; not part of scaffold)
graphify-out/

# Private wiki tree (separate git repo: synthet/my-docs). Nested checkout at wiki/, not a
# submodule — keeps the private remote URL out of the public llm-wiki tree. Clone with:
#   git clone git@github.com:synthet/my-docs.git wiki
wiki/

# OS / editor
.DS_Store
Thumbs.db
