# Environment variable contract — LLM Wiki
#
# Copy to `.env` (git-ignored) and fill in real values. Never commit `.env` or paste
# real values into prompts, logs, or tool arguments (see .agent/SAFETY.md).

# TypeSafe / Jev System One API key (used when retrieval.semantic: typesafe)
JEV_TOKEN=

# Optional provider credentials for compile --mode api|local
# LLMWIKI_API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=
